# Vendor packages compile in place on some builds; never commit the output
# (Vite resolves extensionless src imports to .js before .ts and stale
# compiled JS poisons the runtime import graph).
vendor/*/src/**/*.js
vendor/*/src/**/*.js.map
vendor/*/src/**/*.d.ts
vendor/*/src/**/*.d.ts.map

# in-place build residue under src/ (emitted by package builds; never commit)
packages/*/*/src/*.js
packages/*/*/src/*.js.map
packages/*/*/src/*.d.ts
packages/*/*/*/src/*.js
packages/*/*/*/src/*.js.map
packages/*/*/*/src/*.d.ts
