{
  "name": "@deepseek-ai/dsh-host-update-engine",
  "description": "Dependency-free delta update engine: manifest hashing, the total preservation/classification matrix, embedded 3-way merge, staged apply with journal and qualified verification",
  "version": "0.1.7-enpoi.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/update-engine"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cli": {
      "types": "./lib/types/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/cli.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT"
}
