{
  "name": "dsh-enpoi-peer-routing",
  "version": "0.1.0",
  "private": true,
  "description": "Policy-gated model discovery and selection for the device-to-device peer API (peerRouting service)",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node22 --external:@deepseek-ai/* --external:schemastery --external:dsh-enpoi-* --outfile=lib/index.js"
  },
  "dependencies": {
    "dsh-enpoi-catalog-rules": "workspace:*",
    "dsh-enpoi-contracts": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
