{
  "name": "dsh-enpoi-model-chains",
  "version": "0.1.0",
  "description": "Settings-defined model failover chains (enpoi-orchestration.chains) exposed as the frozen-snapshot modelChains service",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node22 --external:@deepseek-ai/* --external:schemastery --external:dsh-enpoi-* --outfile=lib/index.js"
  },
  "dependencies": {
    "dsh-enpoi-contracts": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
